22. Utilice un led RGB para generar 5 colores diferentes en una secuencia pwm.
(Este punto puede generarlo por simulación).
const int rojo = 9;
const int verde = 10;
const int azul = 11;
void setup() {
  pinMode(rojo, OUTPUT);
  pinMode(verde, OUTPUT);
  pinMode(azul, OUTPUT);
}
void loop() {
  // 1. Rojo
  analogWrite(rojo, 255);
  analogWrite(verde, 0);
  analogWrite(azul, 0);
  delay(1000);
  // 2. Verde
  analogWrite(rojo, 0);
  analogWrite(verde, 255);
  analogWrite(azul, 0);
  delay(1000);
  // 3. Azul
  analogWrite(rojo, 0);
  analogWrite(verde, 0);
 analogWrite(azul, 255);
  delay(1000);
  // 4. Amarillo
  analogWrite(rojo, 255);
  analogWrite(verde, 255);
  analogWrite(azul, 0);
  delay(1000);
  // 5. Magenta
  analogWrite(rojo, 255);
  analogWrite(verde, 0);
  analogWrite(azul, 255);
  delay(1000);
}

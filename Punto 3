3. Utilice el circuito anterior para realizar un semáforo, este deberá mostrar
correctamente el tiempo de cambio de cada led.
R: int rojo = 3, amarillo = 4, verde = 5;
void setup() {
pinMode(rojo, OUTPUT);
pinMode(amarillo, OUTPUT);
pinMode(verde, OUTPUT);
}
void loop() {
digitalWrite(verde, HIGH);
delay(5000);
digitalWrite(verde, LOW);
digitalWrite(amarillo, HIGH);
delay(2000);
digitalWrite(amarillo, LOW);
digitalWrite(rojo, HIGH);
delay(5000);
digitalWrite(rojo, LOW);
}
